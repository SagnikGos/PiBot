{
  "name": "pibot",
  "version": "0.1.0",
  "description": "PπBot — AI coding agent for the terminal. No frameworks, no SDKs, just raw TypeScript.",
  "type": "module",
  "bin": {
    "pibot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
